# Every environment variable Vouchwell reads, by name. Names only: a value
# never belongs in this file, and scripts/repo-hygiene.mjs refuses one.
#
# Every entry is commented out, and nothing is required: each variable has a
# default or turns a feature on when set. Uncomment only the ones you set. An
# empty value is not the same as an unset one: an empty VOUCHWELL_DB would put
# the hub's database in the current directory, an empty VOUCHWELL_SIGNER would
# name a signer that does not exist.
#
# Set real values in your host's settings for production and for previews, or
# in a .env that stays out of git (.gitignore covers it). Secrets (tokens,
# passwords, signing secrets) go there only, never in code or in this file.
#
# Where each is explained: docs/HUB.md (hub), docs/DEPLOY.md (a node with
# Docker), docs/STREAMING.md (event streams), packages/cli/README.md (vw).
# scripts/env-example.test.mjs fails when the code reads a variable that is not
# listed here.


# ── Hub server (vouchwell-hub): listening, storage, the network in front ──

# Default 8787.
# VOUCHWELL_PORT=
# Default 0.0.0.0.
# VOUCHWELL_HOST=
# Default ./data/vouchwell.db. Put it on a durable, backed-up volume.
# VOUCHWELL_DB=
# Base URL for invitation and reset links, and for SSO's redirect URI.
# VOUCHWELL_PUBLIC_URL=
# 1 only behind a proxy you control.
# VOUCHWELL_TRUST_PROXY=
# 1 for local development only: drops Secure on cookies, and HSTS.
# VOUCHWELL_INSECURE_COOKIES=
# off silences the per-request JSON logs.
# VOUCHWELL_ACCESS_LOG=


# ── Hub server: behaviour ──

# Receipts between automatic checkpoints. Default 500.
# VOUCHWELL_CHECKPOINT_EVERY=
# Seconds before an undecided escalation expires. Default 900.
# VOUCHWELL_APPROVAL_TTL=
# Minutes between re-verifying every stored log. Default 60.
# VOUCHWELL_SELFCHECK_MINUTES=
# Minutes between retention runs. Default 60; 0 disables retention.
# VOUCHWELL_RETENTION_SWEEP_MINUTES=
# 1 runs a witness and nothing else.
# VOUCHWELL_WITNESS_ONLY=
# Where the witness journal lives, ideally on another disk; off disables it.
# VOUCHWELL_WITNESS_JOURNAL=
# 1 lets witnesses, event streams and SSO discovery reach private addresses.
# VOUCHWELL_EGRESS_ALLOW_PRIVATE=
# 1 lets an SSO provider live on a private address.
# VOUCHWELL_OIDC_ALLOW_PRIVATE=


# ── Hub server: backups ──

# Set to turn on scheduled backups into this directory.
# VOUCHWELL_BACKUP_DIR=
# Hours between snapshots. Default 6.
# VOUCHWELL_BACKUP_HOURS=
# Snapshots kept before the oldest is pruned.
# VOUCHWELL_BACKUP_KEEP=


# ── Hub server: invitation and password-reset links ──

# A webhook the links are POSTed to.
# VOUCHWELL_NOTIFY_URL=
# Secret. Bearer token sent to that webhook.
# VOUCHWELL_NOTIFY_TOKEN=


# ── Hub server: signing keys in a KMS or HSM instead of the database ──

# For both roles. local (the default), command or http.
# VOUCHWELL_SIGNER=
# The signer's raw Ed25519 public key, base64url.
# VOUCHWELL_PUBLIC_KEY=
# command signer: the program to run, and its arguments.
# VOUCHWELL_SIGNER_COMMAND=
# VOUCHWELL_SIGNER_ARGS=
# http signer: where signing requests go, and (secret) its bearer token.
# VOUCHWELL_SIGNER_URL=
# VOUCHWELL_SIGNER_TOKEN=

# Per role, overriding the above. Keep the witness key in different custody.
# The *_SIGNER_TOKEN ones are secrets.
# VOUCHWELL_HUB_SIGNER=
# VOUCHWELL_HUB_PUBLIC_KEY=
# VOUCHWELL_HUB_SIGNER_COMMAND=
# VOUCHWELL_HUB_SIGNER_ARGS=
# VOUCHWELL_HUB_SIGNER_URL=
# VOUCHWELL_HUB_SIGNER_TOKEN=
# VOUCHWELL_WITNESS_SIGNER=
# VOUCHWELL_WITNESS_PUBLIC_KEY=
# VOUCHWELL_WITNESS_SIGNER_COMMAND=
# VOUCHWELL_WITNESS_SIGNER_ARGS=
# VOUCHWELL_WITNESS_SIGNER_URL=
# VOUCHWELL_WITNESS_SIGNER_TOKEN=


# ── Hub server: the first organization (vouchwell-hub bootstrap, run once) ──

# Organization name, default Acme, and its slug, by default made from the name.
# VOUCHWELL_ORG=
# VOUCHWELL_ORG_SLUG=
# The first owner's email.
# VOUCHWELL_ADMIN_EMAIL=
# Secret. Left unset, a random password is generated and printed.
# VOUCHWELL_ADMIN_PASSWORD=


# ── A node deployed with Docker (deploy/, and deploy/env.example) ──

# The hostname the node answers on.
# VOUCHWELL_DOMAIN=
# An email for Let's Encrypt, or internal for a self-signed certificate.
# VOUCHWELL_TLS=
# The witness journal on a separate disk.
# VOUCHWELL_JOURNAL_DIR=
# proofwire, for a node set up before the rename.
# COMPOSE_PROJECT_NAME=


# ── The vw command line ──

# off turns coding-agent hook recording off.
# VOUCHWELL_HOOK=
# Milliseconds a writer waits for the log's lock. Default 15000.
# VOUCHWELL_LOCK_WAIT_MS=
# The older name for the same.
# VOUCHWELL_HOOK_LOCK_WAIT_MS=
# Any value prints stack traces on errors.
# VOUCHWELL_DEBUG=

# Secrets read instead of command-line flags, to keep them out of shell history.
# vw slack connect:
# VOUCHWELL_SLACK_WEBHOOK_URL=
# VOUCHWELL_SLACK_SIGNING_SECRET=
# vw witnesses add:
# VOUCHWELL_WITNESS_TOKEN=
# vw streams add (VOUCHWELL_STREAM_HEADERS is a JSON object of extra headers):
# VOUCHWELL_STREAM_TOKEN=
# VOUCHWELL_STREAM_SECRET=
# VOUCHWELL_STREAM_HEADERS=


# ── The Claude Code plugin ──

# For development: a checkout's own vw instead of the version the plugin pins.
# VOUCHWELL_PLUGIN_CLI=


# ── This repository's own scripts, not the app ──

# scripts/witness-record.mjs, for its tests: a scratch checkout to read.
# VOUCHWELL_RECORD_ROOT=
# scripts/docker-smoke.mjs: the hub container (default http://localhost:8787),
# a witness container, and (secrets) the keys it uses.
# HUB_URL=
# WITNESS_URL=
# AGENT_TOKEN=
# AUDIT_TOKEN=
# WITNESS_TOKEN=


# ── Set by whatever runs Vouchwell. Never set these yourself ──

# Claude Code, for the plugin:
#   CLAUDE_PLUGIN_ROOT  CLAUDE_PLUGIN_DATA  CLAUDE_PROJECT_DIR
#   CLAUDE_PLUGIN_OPTION_MODE  CLAUDE_PLUGIN_OPTION_LOG_DIR  CLAUDE_PLUGIN_OPTION_POLICY
# GitHub Actions, for the verify action. VW_* come from its inputs (verify/action.yml):
#   GITHUB_OUTPUT  GITHUB_STEP_SUMMARY
#   VW_BUNDLES  VW_LOG_KEY  VW_LOG_KEYS  VW_WITNESSES  VW_WITNESS_KEY  VW_WITNESS_KEYS  VW_ALLOW_EMPTY
# npm, when it runs a command (vw demo reads it to tell npx from an install):
#   npm_command
# The operating system and terminal:
#   PATH  PATHEXT  TERM  NO_COLOR  USER  USERNAME
