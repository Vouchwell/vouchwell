{
  "name": "@vouchwell/proxy",
  "version": "0.8.1",
  "type": "module",
  "description": "Drop-in MCP proxy that enforces Vouchwell policy and writes receipts.",
  "license": "Apache-2.0",
  "author": "IdeaboticsAI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vouchwell/vouchwell.git",
    "directory": "packages/proxy"
  },
  "homepage": "https://vouchwell.axonscape.com",
  "bugs": {
    "url": "https://github.com/Vouchwell/vouchwell/issues"
  },
  "keywords": [
    "mcp",
    "mcp-proxy",
    "mcp-security",
    "mcp-gateway",
    "model-context-protocol",
    "ai-agents",
    "agent-security",
    "guardrails",
    "policy-engine",
    "audit-log",
    "tamper-evident"
  ],
  "main": "./src/proxy.js",
  "types": "./types/proxy.d.ts",
  "exports": {
    ".": {
      "types": "./types/proxy.d.ts",
      "default": "./src/proxy.js"
    },
    "./jsonrpc": {
      "types": "./types/jsonrpc.d.ts",
      "default": "./src/jsonrpc.js"
    },
    "./approve": {
      "types": "./types/approve.d.ts",
      "default": "./src/approve.js"
    },
    "./remote": {
      "types": "./types/remote.d.ts",
      "default": "./src/remote.js"
    }
  },
  "files": [
    "src",
    "types"
  ],
  "scripts": {
    "test": "node --no-warnings=ExperimentalWarning --test"
  },
  "dependencies": {
    "@vouchwell/core": "0.8.1"
  },
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
