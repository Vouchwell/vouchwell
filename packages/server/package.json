{
  "name": "@vouchwell/server",
  "version": "0.8.1",
  "type": "module",
  "description": "Vouchwell hub — multi-tenant transparency log, policy registry, approvals, and witness service.",
  "license": "Apache-2.0",
  "author": "IdeaboticsAI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vouchwell/vouchwell.git",
    "directory": "packages/server"
  },
  "homepage": "https://vouchwell.axonscape.com",
  "bugs": {
    "url": "https://github.com/Vouchwell/vouchwell/issues"
  },
  "keywords": [
    "mcp",
    "ai-agents",
    "agent-security",
    "audit-log",
    "tamper-evident",
    "transparency-log",
    "witness",
    "approvals",
    "multi-tenant",
    "siem",
    "compliance",
    "self-hosted"
  ],
  "main": "./src/app.js",
  "types": "./types/app.d.ts",
  "exports": {
    ".": {
      "types": "./types/app.d.ts",
      "default": "./src/app.js"
    },
    "./store": {
      "types": "./types/store.d.ts",
      "default": "./src/store.js"
    },
    "./auth": {
      "types": "./types/auth.d.ts",
      "default": "./src/auth.js"
    }
  },
  "bin": {
    "vouchwell-hub": "./src/bin.js"
  },
  "files": [
    "src",
    "types"
  ],
  "scripts": {
    "test": "node --no-warnings=ExperimentalWarning --test"
  },
  "dependencies": {
    "@vouchwell/core": "0.8.1"
  },
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  }
}
